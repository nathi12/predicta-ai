# Copy to .env.local and fill in.

# --- Required -------------------------------------------------------------
# Football-Data.org v4 API token — https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- Optional: API-Football (live form, provider probs, and bet-slip odds) --
# DIRECT key from dashboard.api-football.com. Free plan = 100 req/day, ~10/min.
# The free plan blocks `?league=&season=` fixture queries for the current season,
# so the code resolves fixtures via `?date=` and prices odds per fixture. RapidAPI
# is not a substitute — its free plan only exposes seasons 2021-2023.
API_FOOTBALL_KEY=
RAPIDAPI_KEY=

# Bet-slip builder: which bookmaker to price against — an id from
# GET /odds/bookmakers. Betway (24) is in that list but is NOT quoted in the free
# plan's odds feed for the top European leagues; Bet365 (8) is, and covers every
# market the builder uses. Blank = consensus median across all quoted books.
# Without a direct API_FOOTBALL_KEY the builder just uses fair odds (1 / p).
API_FOOTBALL_BOOKMAKER_ID=8

# --- Required for the accuracy tracker -----------------------------------
# Any random string; the same value must be set as a Vercel env var so Cron
# can call /api/cron/grade.
CRON_SECRET=

# --- Storage (optional in dev) -----------------------------------------
# From a Vercel KV / Upstash Redis store. Without these, dev uses .cache/kv.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Misc --------------------------------------------------------------
# Canonical site URL (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=
